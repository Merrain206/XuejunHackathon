# ============================================================================
#  X-Ray 企业穿透分析 · 环境变量模板
#  用法：复制成 .env，需要时改动；所有项都有默认值，缺 .env 也能启动。
#      Windows:      copy .env.example .env
#      macOS/Linux:  cp .env.example .env
#  ⚠️ .env 已在 .gitignore 中排除，不要把真实密钥提交进版本库。
# ============================================================================

# ---------------------------- 应用 ----------------------------
DEBUG=false
# 接口前缀必须留空：路径就是 /companies/{stock_code}/ask
# （填 /api/v1 会被 config.py 直接拒绝启动）
API_PREFIX=
HOST=127.0.0.1
PORT=8000

# ---------------------------- 数据源：cninfo.db ----------------------------
# 从 PDF 提取的公告原文库（表 docs）。相对路径锚定到 xray-backend/，也可写绝对路径。
DB_PATH=data/cninfo.db
# 规范名（BACKEND_NEXT_STEPS.md 规定）：DATABASE_PATH。
# 两者都支持，DATABASE_PATH 优先；留空则沿用 DB_PATH 的值。
# DATABASE_PATH=D:\Codes\XueJunHackathon\cninfo.db
DATABASE_PATH=
# 找不到 DB_PATH 时会自动尝试 ../data/cninfo.db（数据库放在工作区根目录时）。
# 设为 true 则只认 DB_PATH、不做回退（测试"库不存在"场景用）。
DB_PATH_STRICT=false

# 公告时间窗口（天）。留空 = 不按时间过滤（**推荐**）。
# ⚠️ 实测：真实库最新一份带可解析日期的公告距今已 >365 天，
#    因此固定 365 会把全部有日期的公告筛掉，只剩"文件名无日期"的那些。
# ANALYSIS_WINDOW_DAYS=
# 喂给 LLM 的公告条数上限（太多会撑爆上下文/变贵）
ANALYSIS_MAX_ANNOUNCEMENTS=30
# 单条公告正文截断长度（字符）
ANNOUNCEMENT_MAX_CHARS=4000

# ---------------------------- DeepSeek 大模型 ----------------------------
# 用于按「公告原文」判断风险并生成结论；未配置或调用失败时返回
# 「无足够信息」而不是编造内容。
LLM_ENABLED=true
# 留空 = 不做 LLM 判断，全部返回「无足够信息」
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
REQUEST_TIMEOUT_MS=120000
# ⚠️ 思考模式下 reasoning token 也从这个上限里扣：分析 2 条公告时推理
#    就吃掉 900+ token，正文会直接为空（finish_reason=length）。
#    上限只是封顶、不是目标，给大不会变慢也不会多花钱。
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# 测试/离线演示开关：true 时返回固定假响应，不发起任何网络请求
LLM_FAKE=false

# ---- 思考模式（deepseek-flash）----
# 该接入点实测可用模型：deepseek-flash / deepseek-v4-pro
# （deepseek-chat、deepseek-reasoner 也仍被接受）
# ⚠️ analyzer 的「严格 JSON 抽取」会显式关掉思考：实测开着思考时模型会无限推演，
#    把整个 max_tokens 预算花在 reasoning 上，正文永远为空（finish_reason=length）。
#    这里的开关只影响普通的问答生成路径。
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# ---- 分页 prompt ----
# 按「[第 N 页]」把分页正文喂给模型，它才能回填**真实**的引用页码。
# 关掉的话 ask.py 会因为拿不到可信页码而丢弃相关证据（宁可不答，也不编页码）。
PROMPT_PAGED_TEXT=true
PROMPT_CHARS_PER_PAGE=1200

# ---------------------------- 分析缓存 ----------------------------
# 同一家公司**同一天**不重复调用 LLM，直接读 cache/company_risk_{code}.json
CACHE_ENABLED=true

# ---------------------------- charts（响应体的图表数组）----------------------------
CHARTS_ENABLED=true
CHARTS_MAX=4

# ---------------------------- 查询链路 ----------------------------
ASK_HIT_BUDGET_MS=100            # 读缓存的目标耗时（仅用于日志）
MATCH_SIMILARITY_THRESHOLD=0.8   # matcher 编辑距离阈值

# ---------------------------- 管理接口 ----------------------------
# POST /admin/refresh 的简单 token（也可用 X-Admin-Token 请求头传入）
ADMIN_TOKEN=xray-demo-token

# ---------------------------- 日志 ----------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# 留空 = xray-backend/logs/xray.log
LOG_FILE=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# ---------------------------- CORS ----------------------------
# 前端 MVP 默认跑在 :3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------- 说明：调度 ----------------------------
# 应用内**不含**定时调度器。生产环境由系统 cron 调用
#   scripts/run_night_batch.py
# （参考 deploy/crontab.xray）；demo 环境手动执行：
#   python scripts/run_night_batch.py --demo
