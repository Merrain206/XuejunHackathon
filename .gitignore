# Ask the Company 仓库忽略规则

# ---- Node 依赖与缓存 ----
node_modules/
/node_modules
.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- 构建产物 ----
dist/
build/
/build
.next/
/.next/
/out/
/coverage
*.tsbuildinfo
next-env.d.ts

# ---- 机密与本地配置 ----
# 前端根目录与后端子目录各自使用本地 .env
# 全部排除，但保留 .env.example 模板
.env
.env*
!.env.example
.env.local
.env.*.local
*.env.local
*.pem
.ssh-key/

# ---- 运行期产出 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# ---- 附件副本（Harness 落盘的只读副本，非源码）----
.attachments-tmp/

# ---- 核验用临时产物（体积大，按需下载/生成，不入库）----
xray-backend/.cache-pdf/
xray-backend/.pytest-data-real/
.pytest-cache-real/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- 测试与审计临时目录 ----
.test-tmp/
.pytest-run/
.pytest-data/
.pytest-tmp*/
pytest-cache-files-*/

# ---- 数据源（体积大、由外部提供，不入版本库）----
data/
cninfo_data/
*.db
*.db.bak*
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ---- 部署平台 ----
.vercel

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
