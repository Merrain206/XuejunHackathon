# ============================================================================
#  仓库根 .gitignore
#  三个子项目各自也有 .gitignore（git 会叠加生效）：
#    ai-web-ppt/.gitignore        （若存在）
#    xray-backend/.gitignore
#    xuejun-hackathon/.gitignore
# ============================================================================

# ---- Node 依赖与缓存 ----
node_modules/
.npm-cache/
runtime/

# ---- 构建产物 ----
dist/
build/
.next/
web/dist/

# ---- 机密与本地配置 ----
# 三个项目各有自己的 .env（ai-web-ppt/.env、xray-backend/.env、
# xuejun-hackathon/.env.local），全部排除
.env
.env.local
.env.*.local
*.env.local
.ssh-key/

# ---- 运行期产出 ----
outputs/
uploads/
logs/
*.log
.exports/
*.pptx

# ---- 附件副本（Harness 落盘的只读副本，非源码）----
.attachments-tmp/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- 测试与审计临时目录 ----
.test-tmp/
.pytest-run/
.pytest-data/
.pytest-tmp*/
pytest-cache-files-*/

# ---- 数据源（体积大、由外部提供，不入版本库）----
# 当前实际位置：xuejun-hackathon/data/cninfo.db
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
