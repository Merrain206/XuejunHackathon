# ============================================================================
#  AI 网页 PPT 生成器 · 环境变量模板
#  用法：复制成 .env，把 <必填> 的项填上；不要把真 Key 提交进版本库。
#  Windows:  copy .env.example .env
#  macOS/Linux:  cp .env.example .env
# ============================================================================

# ---------- 必填（缺失时服务会拒绝启动，并打印修法） ----------
# DeepSeek 控制台 → API Keys 创建，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=<必填>
# 模型名（代码里不写死，必须来自这里）
MODEL_NAME=deepseek-flash

# ---------- 服务 ----------
# OpenAI 兼容接口地址；换自建/代理网关时改这里
BASE_URL=https://api.deepseek.com/v1
# 监听地址：127.0.0.1 = 只允许本机；0.0.0.0 = 允许局域网访问（注意无鉴权）
HOST=127.0.0.1
# 端口；被占用时启动会明确报错
PORT=8787
# error | warn | info | debug
LOG_LEVEL=info
# 留空 = 只输出到控制台；填写则同时追加写入该文件（>=5MB 自动轮转为 .1）
LOG_FILE=
# PPTX「保存到项目目录」的落盘位置；留空 = <项目目录>/.exports
OUTPUT_DIR=
# 生产环境标记：production 时 /api/health 不再暴露绝对路径
NODE_ENV=production
# 每个请求体上限（MB）
MAX_UPLOAD_MB=4
# 进程数：0=自动 min(4, CPU-1)，1=单进程，N=固定 N 个
WORKERS=0
# 放在反向代理（nginx/Caddy）后面时设为 1，才能拿到真实客户端 IP
TRUST_PROXY=0
# 跨域白名单，逗号分隔；留空 = 只允许同源（内置前端就是同源，无需配置）
# 仅当前端单独部署在别的域名时才需要，例如 ALLOWED_ORIGINS=https://ppt.example.com
ALLOWED_ORIGINS=
# 只用于「先看界面」的应急开关：设为 1 时缺 Key 也能启动，但生成会失败
ALLOW_INCOMPLETE_CONFIG=0

# ---------- 生成上限（可选） ----------
# MAX_SLIDES=20
# MAX_BULLETS_PER_SLIDE=6
# REQUEST_TIMEOUT_MS=180000

# ---------- 配图（可选；不配也能跑，失败会静默降级为 CSS 渐变） ----------
# auto = 已配置的文生图 API → Openverse 免密 CC0 图库 →（有 Token 时）Pollinations → CSS 渐变
IMAGE_PROVIDER=auto
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_API_KEY=
# IMAGE_MODEL=
# IMAGE_WIDTH=1024
# IMAGE_HEIGHT=720
# Pollinations 匿名调用会带水印，只有填了 Token 才会启用它
# POLLINATIONS_TOKEN=
# OPENVERSE_URL=https://api.openverse.org/v1/images/
# 额外允许 /api/image 代理的域名（逗号分隔）
# IMAGE_PROXY_ALLOW=

# ---------- 联网检索（可选；影响「来源标注」能拿到多少真实来源） ----------
# none | tavily | serper | duckduckgo | custom
SEARCH_PROVIDER=none
# SEARCH_API_KEY=
# SEARCH_API_URL=
# SEARCH_MAX_RESULTS=4

# ---------- PPTX 逐条出现（可选） ----------
# animation = 原生单击入场动画（默认）｜steps = 拆成累积分页（任何阅读器都生效）｜both
PPTX_BUILD_MODE=animation
